<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
    实时宽表映射器(dws_realtime_*)
    所有实时宽表共用, 表名由 ${_tableName} 传入, 字段由调用方传入的 columns/values 动态拼接。
-->
<mapper namespace="com.newzkl.platform.plugin.bi.infrastructure.dao.RealtimeWideTableDAO">

    <!-- 动态列插入: 只插入实体非 null 字段, 不分表硬编码 -->
    <insert id="insert" parameterType="map">
        INSERT INTO ${tableName}
        <foreach collection="columns" item="col" open="(" separator="," close=")">
            ${col}
        </foreach>
        VALUES
        <foreach collection="values" item="val" open="(" separator="," close=")">
            #{val}
        </foreach>
    </insert>

    <!-- 单字段聚合: SUM(指定列), 通用所有数值字段 -->
    <select id="sumField" parameterType="map" resultType="java.math.BigDecimal">
        SELECT COALESCE(SUM(${fieldName}), 0) FROM ${tableName}
        WHERE client = #{client}
    </select>

    <!-- 行数 -->
    <select id="count" parameterType="map" resultType="java.lang.Integer">
        SELECT COUNT(*) FROM ${tableName}
        WHERE
    </select>

    <!-- 清空表 -->
    <delete id="deleteAll" parameterType="map">
        DELETE FROM ${tableName}
    </delete>

</mapper>
