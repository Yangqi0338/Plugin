<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
    实时宽表映射器(dws_realtime_*)
    所有实时宽表共用, 表名由 ${tableName} 传入, 字段由调用方传入的 columns/values 动态拼接。
    实时宽表只维护"今日"增量, 无 bizDate。
-->
<mapper namespace="com.newzkl.platform.plugin.bi.infrastructure.dao.RealtimeWideTableDAO">

    <!-- 动态列插入: 只插入实体非 null 字段 -->
    <insert id="insert" parameterType="map">
        INSERT INTO ${tableName}
        <foreach collection="columns" item="col" open="(" separator="," close=")">
            ${col}
        </foreach>
        VALUES
        <foreach collection="values" item="val" open="(" separator="," close=")">
            #{val}
        </foreach>
    </insert>

    <!-- 单字段聚合: SUM(指定列), 通用所有数值字段 -->
    <select id="sumField" parameterType="map" resultType="com.newzkl.platform.base.common.core.model.money.Money">
        SELECT COALESCE(SUM(${fieldName}), 0) FROM ${tableName}
    </select>

    <select id="sumMapOne" resultType="com.newzkl.platform.base.common.ddd.infrastructure.mybatis.model.BizCountMap">
        SELECT ${query.fieldSQL} FROM ${tableName}
        ${ew.customSqlSegment}
        ${query.groupSQL}
    </select>

    <!-- 查询全部行(供归档) -->
    <select id="selectAll" parameterType="map" resultType="map">
        SELECT * FROM ${tableName}
    </select>

    <!-- 行数 -->
    <select id="count" parameterType="map" resultType="java.lang.Integer">
        SELECT COUNT(*) FROM ${tableName}
    </select>

    <!-- 清空表 -->
    <delete id="deleteAll" parameterType="map">
        DELETE FROM ${tableName}
    </delete>

</mapper>
