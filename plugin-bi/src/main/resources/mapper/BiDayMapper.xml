<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
    日宽表映射器(dws_day_*)
    所有日宽表共用, 表名由 ${_tableName} 传入, 字段由调用方传入的 columns/values 动态拼接。
-->
<mapper namespace="com.newzkl.platform.plugin.bi.infrastructure.dao.DayWideTableDAO">

    <!-- 动态列插入: biz_date 固定在前, 其余字段动态拼接 -->
    <insert id="insert" parameterType="map">
        INSERT INTO ${tableName} (biz_date
        <foreach collection="columns" item="col" open="," separator="," close=")">
            ${col}
        </foreach>
        VALUES (#{bizDate}
        <foreach collection="values" item="val" open="," separator="," close=")">
            #{val}
        </foreach>
    </insert>

    <!-- 单字段聚合: SUM(指定列) 按日期范围 -->
    <select id="sumField" parameterType="map" resultType="java.math.BigDecimal">
        SELECT COALESCE(SUM(${fieldName}), 0) FROM ${tableName}
        WHERE biz_date BETWEEN #{from} AND #{to}
    </select>

    <!-- 行数(日期范围) -->
    <select id="count" parameterType="map" resultType="java.lang.Integer">
        SELECT COUNT(*) FROM ${tableName}
        WHERE biz_date BETWEEN #{from} AND #{to}
    </select>

    <!-- 按 client + 日期范围查全量 -->
    <select id="selectByDateRange" parameterType="map" resultType="map">
        SELECT * FROM ${tableName}
        WHERE
            biz_date BETWEEN #{from} AND #{to}
        ORDER BY biz_date
    </select>

    <!-- 清空表 -->
    <delete id="deleteAll" parameterType="map">
        DELETE FROM ${tableName}
    </delete>

</mapper>
