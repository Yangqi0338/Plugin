<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.newzkl.platform.plugin.openapi.infrastructure.dao.DeveloperDAO">
  <sql id="insert_column">
        `id` ,
        `app_id` ,
        `app_name` ,
        `secret` ,
        `account_id` ,
        `remark`  ,
        `notify_address`
  </sql>
  <sql id="column">
    <include refid="insert_column"></include>,
    `create_time` ,
    `update_time`
  </sql>
  <sql id="set">
    <set>
      <if test="model.appId != null">
        t.`app_id` = #{model.appId},
      </if>
      <if test="model.appName != null">
        t.`app_name` = #{model.appName},
      </if>
      <if test="model.secret != null">
        t.`secret` = #{model.secret},
      </if>
      <if test="model.accountId != null">
        t.`account_id` = #{model.accountId},
      </if>
      <if test="model.remark != null">
        t.`remark` = #{model.remark},
      </if>
    </set>
  </sql>
  <insert id="insert" parameterType="com.newzkl.platform.plugin.openapi.infrastructure.entity.DeveloperDO">
    insert into developer (<include refid="insert_column"></include>)
    values
    (
        #{model.id,jdbcType=BIGINT},
        #{model.appId,jdbcType=VARCHAR},
        #{model.appName,jdbcType=VARCHAR},
        #{model.secret,jdbcType=VARCHAR},
        #{model.accountId,jdbcType=BIGINT},
        #{model.remark,jdbcType=VARCHAR},
        #{model.notifyAddress,jdbcType=VARCHAR}
    )
  </insert>
  <insert id="insertBatch" parameterType="com.newzkl.platform.plugin.openapi.infrastructure.entity.DeveloperDO">
    insert into developer (<include refid="insert_column"></include>)
    values
    <foreach collection="modelList" item="item" separator=",">
      (
          #{item.id,jdbcType=BIGINT},
          #{item.appName,jdbcType=VARCHAR},
          #{item.secret,jdbcType=VARCHAR},
          #{item.accountId,jdbcType=BIGINT},
          #{item.remark,jdbcType=VARCHAR},
      #{item.notifyAddress,jdbcType=VARCHAR}
      )
    </foreach>
  </insert>
  <sql id="where">
      <if test="query.id != null">
        and t.`id` = #{query.id}
      </if>
      <if test="query.idList != null and query.idList.size() > 0">
        and t.`id` in
        <foreach collection="query.idList" item="item" separator="," close=")" open="(">
          #{item}
        </foreach>
      </if>
  </sql>
  <delete id="deleteByPrimaryKey">
    delete from developer t
    <where>
      t.id in
      <foreach collection="idList" item="item" separator="," close=")" open="(">
        #{item}
      </foreach>
    </where>
  </delete>
  <update id="updateByPrimaryKeySelective" parameterType="com.newzkl.platform.plugin.openapi.infrastructure.entity.DeveloperDO">
    update developer t
    <include refid="set"></include>
    where id = #{model.id,jdbcType=BIGINT}
  </update>
  <select id="selectByPrimaryKey" parameterType="java.lang.Long" resultType="com.newzkl.platform.plugin.openapi.infrastructure.entity.DeveloperDO">
    select 
    <include refid="column" />
    from developer
    where id = #{id,jdbcType=BIGINT}
  </select>
  <delete id="deleteByQuery"
          parameterType="com.newzkl.platform.plugin.openapi.model.query.DeveloperQuery">
    delete from developer t
    <where>
      <include refid="where"></include>
    </where>
  </delete>
  <update id="updateByQuery">
    update developer t
    <include refid="set"></include>
    <where>
      <include refid="where"></include>
    </where>
  </update>
  <select id="listByQuery" parameterType="com.newzkl.platform.plugin.openapi.model.query.DeveloperQuery" resultType="com.newzkl.platform.plugin.openapi.model.vo.DeveloperVO">
    select
      t.*
    from developer t
    <where>
      <include refid="where"></include>
    </where>
  </select>
  <select id="countByQuery" resultType="java.lang.Integer" parameterType="com.newzkl.platform.plugin.openapi.model.query.DeveloperQuery">
    select
      count(t.id)
    from developer t
    <where>
      <include refid="where"></include>
    </where>
  </select>
  <!--                                          分割线                                                -->
  <select id="developerVOByAppId" resultType="com.newzkl.platform.plugin.openapi.model.vo.DeveloperVO"
          parameterType="java.lang.String">
    select
    <include refid="column" />
    from developer
    where app_id = #{appId,jdbcType=BIGINT}
  </select>
    <select id="developerVOByAccountId" resultType="com.newzkl.platform.plugin.openapi.model.vo.DeveloperVO"
            parameterType="java.lang.Long">
      select
      <include refid="column" />
      from developer
      where account_id = #{accountId,jdbcType=BIGINT} LIMIT 1
    </select>
</mapper>